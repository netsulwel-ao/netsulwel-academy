rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function getRole() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return getRole() == "admin";
    }

    function isTeacher() {
      return getRole() == "teacher";
    }

    function isAdminOrTeacher() {
      return getRole() == "admin" || getRole() == "teacher";
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getInstitutionId() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId
        : null;
    }

    function isInstitutionAdmin() {
      return getRole() == "institution";
    }

    // ── users ─────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth(); // Only authenticated users can read profiles
      allow create: if isOwner(uid);
      allow update: if isAdmin() ||
        (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["role"]));
      allow delete: if isAdmin();

      match /notifications/{notifId} {
        allow read: if isOwner(uid);
        // Sistema (admin/teacher) pode criar qualquer notificação
        // Aluno só pode criar notificações na sua própria subcoleção e de tipos permitidos
        allow create: if isAdmin() ||
          (isOwner(uid) &&
           request.resource.data.uid == uid &&
            request.resource.data.type in [
              "community_like", "community_comment",
              "payment_approved", "course_complete", "certificate_ready",
              "institution_approved"
            ]);
        allow update: if isOwner(uid);
        allow delete: if isAdmin() || isOwner(uid);
      }
    }

    // ── courses ───────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if resource.data.status == "published" || isAdminOrTeacher();
      // Teacher pode criar/editar apenas os seus próprios cursos
      allow create: if isAdminOrTeacher();
      allow update: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
    }

    // ── trails ────────────────────────────────────────────
    match /trails/{trailId} {
      allow read: if resource.data.status == "published" || isAdminOrTeacher();
      allow create: if isAdminOrTeacher();
      allow update: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
    }

    // ── announcements ─────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAdminOrTeacher() ||
        (isAuth() && resource.data.active == true);
      allow create: if isAdminOrTeacher();
      allow update: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
    }

    // ── countdownBanners ──────────────────────────────────
    match /countdownBanners/{bannerId} {
      allow read: if isAdminOrTeacher() ||
        (isAuth() && resource.data.active == true);
      allow create, update, delete: if isAdmin();
    }

    // ── lives ─────────────────────────────────────────────
    match /lives/{liveId} {
      allow read: if isAuth();
      allow create: if isAdminOrTeacher();
      allow update: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);

      match /chat/{msgId} {
        allow read: if isAuth();
        allow create: if isAuth() && (
          request.resource.data.uid == request.auth.uid ||
          (isAdminOrTeacher() && request.resource.data.type == "system")
        );
        allow update, delete: if isAdminOrTeacher();
      }

      match /speakers/{speakerId} {
        allow read: if isAuth();
        allow write: if isAdminOrTeacher();
      }

      match /handraises/{requestId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isAdminOrTeacher();
      }
    }

    // ── enrollments ───────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read: if isAdminOrTeacher() ||
        (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin(); // Only admin/backend can create enrollments
      allow update, delete: if isAdmin();
    }

    // ── progress ──────────────────────────────────────────
    match /progress/{userId} {
      // Subcoleção de progresso por curso
      match /courses/{courseId} {
        allow read, write: if isAdminOrTeacher() || isOwner(userId);
      }
      // Documento raiz (compatibilidade)
      allow read: if isAdminOrTeacher() || isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ── certificates ──────────────────────────────────────
    match /certificates/{userId} {
      // Subcoleção de certificados por curso
      match /courses/{courseId} {
        allow read: if isAdminOrTeacher() || isOwner(userId);
        allow write: if isOwner(userId); // aluno cria o próprio certificado ao completar
      }
      // Documento raiz
      allow read: if isAdminOrTeacher() || isOwner(userId);
      allow write: if isAdmin();
    }

    // ── sales ─────────────────────────────────────────────
    match /sales/{saleId} {
      allow read: if isAdminOrTeacher() ||
        (isAuth() && resource.data.userId == request.auth.uid) ||
        (isAuth() && resource.data.sellerId == request.auth.uid) ||
        (isInstitutionAdmin() && resource.data.sellerId == getInstitutionId());
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── settings ──────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── community ─────────────────────────────────────────
    match /community/{postId} {
      allow read: if true;
      allow create: if isAuth() &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isAdminOrTeacher() ||
        request.auth.uid == resource.data.authorId;
      allow delete: if isAdminOrTeacher() ||
        request.auth.uid == resource.data.authorId;

      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuth() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth() &&
          request.resource.data.authorId == request.auth.uid;
        allow update: if isAdminOrTeacher() ||
          request.auth.uid == resource.data.authorId;
        allow delete: if isAdminOrTeacher() ||
          request.auth.uid == resource.data.authorId;
      }
    }

    // ── ratings ───────────────────────────────────────────
    match /ratings/{docId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── broadcasts ────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdminOrTeacher();
    }

    // ── institutions ─────────────────────────────────────
    match /institutions/{institutionId} {
      allow read: if isAuth();
      allow create: if isAdmin(); // Only admin creates via backend API
      allow update: if isAdmin() ||
        (isAuth() && resource.data.adminId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── institutionInviteLinks ────────────────────────────
    match /institutionInviteLinks/{linkId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isInstitutionAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── freeLiveRequests ─────────────────────────────────────
    match /freeLiveRequests/{requestId} {
      allow read: if isAdmin() || isTeacher();
      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── events (tracking analytics) ───────────────────────
    match /events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── exams ─────────────────────────────────────────────
    match /exams/{examId} {
      allow read: if isAuth();
      allow create: if isAdminOrTeacher();
      allow update: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
    }

    // ── exam-results ──────────────────────────────────────
    match /exam-results/{userId} {
      match /exams/{examId} {
        allow read: if isAdminOrTeacher() || isOwner(userId);
        allow create: if isAdmin(); // Only admin/backend can create results
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── moduleQuizzes ──────────────────────────────────────
    match /moduleQuizzes/{quizId} {
      allow read: if isAdminOrTeacher() ||
        (isAuth() && resource.data.courseId in
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourses);
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
    }

    // ── moduleQuizResults ──────────────────────────────────
    match /moduleQuizResults/{userId} {
      match /quizzes/{resultId} {
        allow read: if isAdminOrTeacher() || isOwner(userId);
        allow create: if isAdmin(); // Only admin/backend can create results
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── courseChats ────────────────────────────────────────
    match /courseChats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["lastMessage", "lastMessageAt", "lastMessageBy", "lastMessageByName"]);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAuth() && request.auth.uid in
          get(/databases/$(database)/documents/courseChats/$(chatId)).data.participants;
        allow create: if isAuth() &&
          request.resource.data.uid == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── private_access_links (Sistema de Links Privados) ──
    match /private_access_links/{linkId} {
      allow read: if isAdminOrTeacher();
      allow create: if isAdminOrTeacher() ||
        (isAuth() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdminOrTeacher() ||
        (isAuth() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() ||
        (isAuth() && resource.data.createdBy == request.auth.uid);
    }

    // ── access_logs (Log de Acessos via Links Privados) ────
    match /access_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // Bloqueia tudo o resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
