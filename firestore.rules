rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      // exists() evita erro quando o documento ainda não existe (ex: registo novo)
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── users ─────────────────────────────────────────────
    match /users/{uid} {
      // CRÍTICO: leitura pública para autenticados — necessário para o AuthContext
      // ler o próprio perfil logo após registo (antes do token estar totalmente propagado)
      allow read: if isAuth();

      // Criação: só o próprio user (no registo) — sem restrições adicionais
      // para evitar race condition entre criação do doc e validação das regras
      allow create: if isOwner(uid);

      // Update: admin pode tudo; user pode atualizar os seus dados mas NÃO role/plan
      allow update: if isAdmin() ||
        (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["role", "plan"]));

      allow delete: if isAdmin();

      // ── Subcoleções do user ──────────────────────────────
      match /notifications/{notifId} {
        allow read: if isOwner(uid);
        // Sistema (admin) pode criar notificações; aluno só tipos permitidos
        allow create: if isAdmin() ||
          (isAuth() && request.resource.data.uid == uid &&
           request.resource.data.type in [
             "community_like", "community_comment",
             "payment_approved", "course_complete", "certificate_ready"
           ]);
        allow update: if isOwner(uid); // marcar como lida
        allow delete: if isAdmin() || isOwner(uid);
      }
    }

    // ── courses ───────────────────────────────────────────
    match /courses/{courseId} {
      // Cursos publicados: qualquer pessoa (incluindo não autenticada) pode ver
      // para funcionar na landing page e páginas de preview
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── trails ────────────────────────────────────────────
    match /trails/{trailId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── announcements ─────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.active == true);
      allow create, update, delete: if isAdmin();
    }

    // ── countdownBanners ──────────────────────────────────
    match /countdownBanners/{bannerId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.active == true);
      allow create, update, delete: if isAdmin();
    }

    // ── lives ─────────────────────────────────────────────
    match /lives/{liveId} {
      // Alunos veem todas as lives (scheduled, live, ended) para histórico
      allow read: if isAuth() || isAdmin();
      allow create, update, delete: if isAdmin();

      // Chat
      match /chat/{msgId} {
        allow read: if isAuth();
        allow create: if isAuth() && (
          request.resource.data.uid == request.auth.uid ||
          (isAdmin() && request.resource.data.type == "system")
        );
        allow update, delete: if isAdmin();
      }

      // Speakers
      match /speakers/{speakerId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    // ── enrollments ───────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── progress ──────────────────────────────────────────
    match /progress/{progressId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isAuth() && resource.data.userId == request.auth.uid);
    }

    // ── certificates ──────────────────────────────────────
    match /certificates/{certId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ── sales ─────────────────────────────────────────────
    match /sales/{saleId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── settings ──────────────────────────────────────────
    // Leitura pública — contém apenas SEO/meta/contacto, nada sensível
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── community ─────────────────────────────────────────
    match /community/{postId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() ||
        request.auth.uid == resource.data.authorId;
      allow delete: if isAdmin() ||
        request.auth.uid == resource.data.authorId;

      match /likes/{userId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.resource.data.authorId == request.auth.uid;
        allow update: if isAdmin() ||
          request.auth.uid == resource.data.authorId;
        allow delete: if isAdmin() ||
          request.auth.uid == resource.data.authorId;
      }
    }

    // ── ratings ───────────────────────────────────────────
    match /ratings/{docId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── broadcasts ────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Bloqueia tudo o resto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
